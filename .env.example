# ============================================================================
# ELEVE | Environment Variables Configuration
# ============================================================================

# Supabase PostgreSQL Cloud URL & Anon Public API Key
# If omitted or left as placeholder, ELEVE operates seamlessly in Persistent Offline Demo Mode
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Optional Google Gemini / OpenAI Live API Key for real-time neural AI Coach
# (Can also be configured interactively within the UI in /coach)
VITE_AI_API_KEY=
